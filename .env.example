# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=indie_game_radar

# Redis
REDIS_URL=redis://localhost:6379/0

# IGDB/Twitch OAuth
IGDB_CLIENT_ID=your_igdb_client_id
IGDB_CLIENT_SECRET=your_igdb_client_secret
IGDB_BASE_URL=https://api.igdb.com/v4
TWITCH_OAUTH_URL=https://id.twitch.tv/oauth2/token

# Steam
STEAM_STORE_BASE=https://store.steampowered.com/api
STEAM_WEBAPI_BASE=https://api.steampowered.com

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=@your_channel_or_chat_id

# Behavior
SCORE_PUBLISH_THRESHOLD=0.7
TOP_N_TO_PUBLISH=5
RUN_INTERVAL_SECONDS=14400
ONE_SHOT=false

# HTTP/limits
HTTP_TIMEOUT_SECONDS=15
STEAM_MAX_CONCURRENCY=5
IGDB_MAX_CONCURRENCY=3
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_BASE=0.5
HTTP_RETRY_BACKOFF_MAX=5.0

# Cache TTLs
CACHE_TTL_STEAM_DETAILS=3600
CACHE_TTL_IGDB_META=21600
