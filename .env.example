# ----------------------------------------------------------------------------------------------------------------------
# Indie Game Radar — required environment variables
# All variables below are REQUIRED: the app validates them at startup via pydantic-settings
# (see src/config/settings.py). Non-secret runtime knobs live in src/config/constants.py.
# ----------------------------------------------------------------------------------------------------------------------

# MongoDB
MONGO_URI=mongodb://localhost:27017

# Steam WebAPI (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=your_steam_api_key

# IGDB / Twitch OAuth (https://dev.twitch.tv/console/apps)
IGDB_CLIENT_ID=your_igdb_client_id
IGDB_CLIENT_SECRET=your_igdb_client_secret

# Reddit app credentials (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=igr/0.1 by your_reddit_username

# OpenAI (filtering, embeddings, editorial refinement)
OPEN_AI_KEY=your_openai_api_key

# Telegram Bot API (@BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=@your_channel_or_chat_id

# Telethon user client (https://my.telegram.org → API development tools)
TELETHON_API_ID=12345678
TELETHON_API_HASH=your_telethon_api_hash

# Forwarder: listen to this channel and forward new posts to this bot/chat
SOURCE_CHANNEL_USERNAME=@your_source_channel
TARGET_BOT_USERNAME=@your_target_bot_or_chat

# ----------------------------------------------------------------------------------------------------------------------
# Notes:
# - Mongo DB name (indie_game_radar) is a constant in src/config/constants.py — override it
#   there, not here.
# - Telethon creates a session file on first run (TELETHON_SESSION constant). Keep it out of git.
# - Optional Tumblr publishing is configured via TUMBLR_* constants in src/config/constants.py.
# ----------------------------------------------------------------------------------------------------------------------
